# Copy to .env and fill in. Never commit .env.

APP_ENV=development
SECRET_KEY=change-me

# Used by docker-compose to create and reach the database
POSTGRES_USER=mfa_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mfa

# Used when running the API outside Docker.
# Inside Docker, docker-compose.yml overrides these two.
DATABASE_URL=postgresql://mfa_user:change-me@localhost:5432/mfa
REDIS_URL=redis://localhost:6379/0

# Key used to encrypt biometric templates (32 random bytes, base64)
TEMPLATE_ENCRYPTION_KEY=change-me

# Login protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
OTP_VALID_SECONDS=30