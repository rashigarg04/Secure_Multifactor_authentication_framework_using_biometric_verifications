# ---------- Server ----------
NODE_ENV=development
PORT=4000

# ---------- Database ----------
# Leave MONGODB_URI empty to use the in-memory fallback (data is lost on restart).
# Local example:  mongodb://127.0.0.1:27017/mfa_biometric
# Atlas example:  mongodb+srv://USER:PASS@cluster.mongodb.net/mfa_biometric
MONGODB_URI=

# ---------- JWT / sessions ----------
# Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c7b6a5f4e3d2c1b0a9f8
# Full session token lifetime
JWT_EXPIRES_IN=1h
# Short-lived token issued after the password step when MFA is still pending
MFA_PENDING_EXPIRES_IN=5m

# ---------- WebAuthn (must match the browser URL exactly) ----------
# RP_ID is the domain only: no scheme, no port, no path.
RP_ID=localhost
RP_NAME=Secure MFA Framework
# ORIGIN is the full origin the browser shows in the address bar.
ORIGIN=http://localhost:5173

# ---------- CORS ----------
CLIENT_URL=http://localhost:5173

# ---------- Login protection ----------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0